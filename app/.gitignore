# Le fichier pubspec.lock est volontairement versionné (application, pas package).

# Projets natifs : non versionnés dans ce squelette, régénérés via
# `flutter create --platforms ios,android .` (voir README).
/android/
/ios/

# Symbolication et obfuscation
app.*.symbols
app.*.map.json

# Fichiers d'environnement (--dart-define-from-file) : jamais commités
/env/*.json
