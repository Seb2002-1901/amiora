# Divers
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/

# Flutter / Dart / Pub
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Le fichier pubspec.lock est volontairement versionné (application, pas package).

# Android : projet VERSIONNÉ (permission INTERNET en release, intent-filter
# OAuth, label AMIORA, icônes, lancement sombre) — seuls les fichiers locaux
# et générés sont ignorés.
/android/.gradle/
/android/local.properties
/android/**/build/
/android/*.iml
/android/.kotlin/

# iOS : projet Xcode VERSIONNÉ (identifiant, schéma OAuth, réglages
# TestFlight) — seuls les fichiers générés à chaque build sont ignorés.
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/
/ios/Flutter/App.framework
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Pods/
/ios/Podfile.lock
/ios/.symlinks/
/ios/Runner.xcworkspace/xcshareddata/swiftpm/
/ios/**/xcuserdata/

# Symbolication et obfuscation
app.*.symbols
app.*.map.json

# Fichiers d'environnement (--dart-define-from-file) : jamais commités
/env/*.json
